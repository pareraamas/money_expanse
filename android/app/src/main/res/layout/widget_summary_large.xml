<?xml version="1.0" encoding="utf-8"?>
<!-- ≥ 4×2: saldo, masuk/keluar bulan ini, keluar hari ini, tombol catat. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Saldo"
                android:textColor="@color/widget_ink_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Rp 0"
                android:textColor="@color/widget_ink"
                android:textSize="24sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/add_expense"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_button_expense"
            android:contentDescription="Catat pengeluaran"
            android:padding="11dp"
            android:src="@drawable/ic_widget_minus" />

        <ImageView
            android:id="@+id/add_income"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button_income"
            android:contentDescription="Catat pemasukan"
            android:padding="11dp"
            android:src="@drawable/ic_widget_plus" />
    </LinearLayout>

    <!-- Pengisi ruang (RemoteViews tidak mendukung View biasa). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="8dp" />

    <TextView
        android:id="@+id/month_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:maxLines="1"
        android:text="Bulan ini"
        android:textColor="@color/widget_ink_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="▲ Masuk"
                android:textColor="@color/widget_income"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/month_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Rp 0"
                android:textColor="@color/widget_ink"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="▼ Keluar"
                android:textColor="@color/widget_expense"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/month_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Rp 0"
                android:textColor="@color/widget_ink"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_chip"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Hari ini"
                android:textColor="@color/widget_ink_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/today_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Rp 0"
                android:textColor="@color/widget_ink"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
